# -----------------------------------------------------------------
# This template contains all required environment variables to set
# Visit the docs to find more information https://github.com/jiisanda/docflow/blob/master/app/docs/setup.md
# -----------------------------------------------------------------

# add only the database password if you want to run with the default postgres, otherwise change setting accordingly
HOST_URL=http://docflow.localhost   [public base URL of the app, used in share links]

DATABASE_HOSTNAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=docflow_db
POSTGRES_DB_TESTS=docflow_test_db

# For local RustFS, AWS_* must match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY below
AWS_ACCESS_KEY_ID=[access key]
AWS_SECRET_ACCESS_KEY=[secret key]
AWS_REGION=us-east-1   [rustfs doesn't require a region]
S3_ENDPOINT_URL=http://rustfs:9000   [leave empty for AWS S3]
S3_PUBLIC_ENDPOINT_URL=http://store.docflow.localhost   [host browsers use for presigned URLs; leave empty for AWS S3]
# bucket names can't contain underscores
S3_BUCKET=docflow-s3
S3_TEST_BUCKET=docflow-test-s3

# RustFS (local S3-compatible storage), dev only
RUSTFS_ACCESS_KEY=[same as AWS_ACCESS_KEY_ID]
RUSTFS_SECRET_KEY=[same as AWS_SECRET_ACCESS_KEY]
# Encryption at rest: master key wrapping RustFS's KMS keys. Generate with
# `openssl rand -base64 32` and BACK IT UP: without it, stored files are unreadable.
RUSTFS_KMS_LOCAL_MASTER_KEY=[base64 32-byte key]

# User Env
ACCESS_TOKEN_EXPIRE_MIN=300
REFRESH_TOKEN_EXPIRE_MIN=30
ALGORITHM=<algorithm>

# random secret key, use python's secrets.token_urlsafe() or secrets.token_hex() to generate one
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Email Service
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Add email and apps password following the steps in docs https://github.com/jiisanda/docflow/blob/master/app/docs/setup.md
EMAIL=
APP_PASSWORD=<password_of_registered_app>
